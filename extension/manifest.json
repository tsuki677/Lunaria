{
  "manifest_version": 3,
  "name": "Lunaria — New Tab",
  "version": "1.1.3",
  "description": "A moonlit, anime-inspired new tab page with customizable colors and shortcuts.",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lunaria-new-tab@tsuki677.github.io",
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/lunaria.svg",
    "96": "icons/lunaria.svg"
  }
}
